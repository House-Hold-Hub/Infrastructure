# House Hold Hub - local environment contract (provider-neutral).
#
# Copy to .env and edit:   cp .env.example .env
# NEVER commit .env. Values below are LOCAL PLACEHOLDERS, not real secrets.
# Do not reuse them in any shared, staging or production environment.
#
# Legend:  [required] must be set | [optional] has a default shown in brackets
# Source of truth for each variable: Backend config/settings.py, Backend
# Dockerfile, Frontend src/config.ts + Dockerfile. This file adds no variable
# that those services do not read.
#
# No email, deployment, secret-store or monitoring variables exist here on
# purpose: those providers are deferred (D02: email before M1 integration,
# deployment/secret-store/monitoring before M9). D03 gates real personal data
# (including real-email staging): use synthetic data only with this file.

# =============================================================================
# 1. PostgreSQL
# Read by the Backend (database connection) and, by the same names, by the
# official PostgreSQL image to initialise the database on first start.
# =============================================================================

# [optional, default: householdhub] Database name.
POSTGRES_DB=householdhub

# [optional, default: householdhub] Database role.
POSTGRES_USER=householdhub

# [required for the local stack - SECRET] Role password. The Backend defaults to
# an empty password, but the PostgreSQL image refuses to start without one.
# Generate your own, e.g.: openssl rand -base64 24
POSTGRES_PASSWORD=change-me-local-only

# [optional, default: localhost] Host the Backend connects to. Use localhost
# when Backend runs on the host; the compose service name when it runs in a
# container (final value defined by Infrastructure#1).
POSTGRES_HOST=localhost

# [optional, default: 5432] PostgreSQL port.
POSTGRES_PORT=5432

# =============================================================================
# 2. Backend runtime (read at process start; change + restart to apply)
# =============================================================================

# [required - SECRET] Django signing key. No default: the Backend refuses to
# start without it. Generate your own, e.g.: openssl rand -base64 48
DJANGO_SECRET_KEY=change-me-local-only-generate-your-own

# [optional, default: false] Debug mode. true ONLY for local development.
DJANGO_DEBUG=true

# [optional, default: empty] Comma-separated hostnames served by Django.
# Required when DJANGO_DEBUG=false.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# [optional, default: empty] Comma-separated origins (with scheme) trusted for
# CSRF. Needed only behind a TLS-terminating proxy. Leave commented locally.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.invalid

# [optional, default: true when DJANGO_DEBUG=false, else false] Secure flag on
# session/CSRF cookies. Set false for plain-HTTP local runs.
# DJANGO_SECURE_COOKIES=false

# [optional, default: 2] Gunicorn workers in the Backend container image
# (read by the Dockerfile CMD; not read by `manage.py runserver`).
# WEB_CONCURRENCY=2

# =============================================================================
# 3. Frontend build-time (embedded in the JavaScript bundle by Vite)
# These values are PUBLIC: anyone can read them in the built bundle. Never put
# secrets here. Changing a value requires rebuilding the bundle/image.
# =============================================================================

# [optional, default: empty string, i.e. same-origin relative URLs] Base URL of
# the Backend API as seen from the browser. Dockerfile build-arg default and
# local value: http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
