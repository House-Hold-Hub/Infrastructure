# HouseHoldHub Infrastructure local environment contract.
# Copy to .env for local development. Never commit .env or real credentials.
#
# Provider-specific email, deployment, secret-store, and monitoring variables are
# intentionally absent until deferred decision D02 selects those providers.

# Django cryptographic signing secret.
# Required: yes for the Infrastructure local contract.
# Example: local-development-only-change-me (development only; never reuse in production)
DJANGO_SECRET_KEY=local-development-only-change-me

# Enable Django debug behavior for local development.
# Required: yes for the Infrastructure local contract.
# Example: true
DJANGO_DEBUG=true

# Comma-separated hosts accepted by Django.
# Required: yes for the Infrastructure local contract.
# Example: localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL database name.
# Required: yes for the Infrastructure local contract.
# Example: householdhub
POSTGRES_DB=householdhub

# PostgreSQL application user.
# Required: yes for the Infrastructure local contract.
# Example: householdhub
POSTGRES_USER=householdhub

# PostgreSQL application password.
# Required: yes for the Infrastructure local contract.
# Example: householdhub (local development only)
POSTGRES_PASSWORD=householdhub

# PostgreSQL hostname reachable by the Backend runtime.
# Required: yes for the Infrastructure local contract.
# Example: localhost
POSTGRES_HOST=localhost

# PostgreSQL TCP port.
# Required: yes for the Infrastructure local contract.
# Example: 5432
POSTGRES_PORT=5432

# Frontend API base path used by Vite at development/build time.
# Required: yes for the Infrastructure local contract.
# Example: /api/v1
VITE_API_BASE_URL=/api/v1

# Deferred decision gates:
# - D02 selects the managed email provider before M1 email integration.
# - D02 selects deployment, secret-store, and monitoring providers before M9.
# - D03 must be resolved before processing real personal data, including
#   real-email staging.
# Add provider-specific variables only after the corresponding decision is made.
